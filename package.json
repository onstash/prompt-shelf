{
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prototype": "python3 -m http.server 4173",
    "dev": "pnpm --filter prompt-shelf dev",
    "dev:frontend": "pnpm --filter prompt-shelf dev",
    "dev:backend": "pnpm --filter prompt-shelf dev",
    "build": "pnpm --filter prompt-shelf build",
    "build:frontend": "pnpm --filter prompt-shelf build",
    "deploy": "pnpm --filter prompt-shelf deploy",
    "db:migrate:local": "pnpm --filter prompt-shelf db:migrate:local",
    "db:migrate:remote": "pnpm --filter prompt-shelf db:migrate:remote",
    "lint": "pnpm --filter prompt-shelf lint",
    "test": "pnpm --filter prompt-shelf test",
    "format": "pnpm --filter prompt-shelf format",
    "format:check": "pnpm --filter prompt-shelf format:check",
    "prepare": "lefthook install"
